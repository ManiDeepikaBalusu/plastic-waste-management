# Optional: Initial Administrator Bootstrap (Run once on startup to seed admin)
ADMIN_INITIAL_EMAIL=admin@plasticwaste.org
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=System Administrator

# Cloudinary Storage - Required in Milestone 4
CLOUDINARY_CLOUD_NAME=kozxwvl6
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=