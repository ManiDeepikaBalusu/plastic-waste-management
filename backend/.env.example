# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/plastic_waste_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# JWT Security & CORS
JWT_SECRET=
