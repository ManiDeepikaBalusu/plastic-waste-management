# Root .gitignore for Plastic Waste Reporting and Volunteer Tracking System

# Dependencies
node_modules/
target/
.venv/
venv/
env/

# Environment files & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# IDEs & Editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Build artifacts
dist/
build/
*.class
*.jar
*.war
*.ear
__pycache__/
*.pyc

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
