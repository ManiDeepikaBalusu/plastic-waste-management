{
  "info": {
    "_postman_id": "a9b1c2d3-e4f5-6789-0123-abcdef456789",
    "name": "Plastic Waste Management - Milestone 3 Auth API",
    "description": "Postman test suite for authentication, role guards, and resource ownership in Plastic Waste Reporting and Volunteer Tracking System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "current_user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Public Registration - Citizen",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"citizen.jane@example.org\",\n  \"password\": \"CitizenSecret123!\",\n  \"fullName\": \"Jane Citizen\",\n  \"phone\": \"+1-555-0199\",\n  \"role\": \"CITIZEN\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "2. Public Registration - Volunteer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"volunteer.bob@example.org\",\n  \"password\": \"VolunteerSecret123!\",\n  \"fullName\": \"Bob Volunteer\",\n  \"phone\": \"+1-555-0144\",\n  \"role\": \"VOLUNTEER\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "3. Security Check - Reject Public ADMIN Registration",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"fake.admin@example.org\",\n  \"password\": \"AdminSecret123!\",\n  \"fullName\": \"Attacker Admin\",\n  \"role\": \"ADMIN\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "4. Login - Valid Citizen Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('jwt_token', jsonData.token);",
              "    pm.collectionVariables.set('current_user_id', jsonData.user.id);",
              "    console.log('JWT Token saved:', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"citizen.jane@example.org\",\n  \"password\": \"CitizenSecret123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "5. Login - Invalid Password (Expect 401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"citizen.jane@example.org\",\n  \"password\": \"WrongPassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "6. Get Current User Profile (/users/me)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/users/me",
          "host": ["{{base_url}}"],
          "path": ["users", "me"]
        }
      }
    },
    {
      "name": "7. Resource Ownership - Get Own Profile (/users/{id})",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/users/{{current_user_id}}",
          "host": ["{{base_url}}"],
          "path": ["users", "{{current_user_id}}"]
        }
      }
    },
    {
      "name": "8. Resource Ownership - Access Another User (Expect 403)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/users/00000000-0000-0000-0000-000000000001",
          "host": ["{{base_url}}"],
          "path": ["users", "00000000-0000-0000-0000-000000000001"]
        }
      }
    },
    {
      "name": "9. Role Guard - Citizen Accessing Admin Endpoint (Expect 403)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/admin/users",
          "host": ["{{base_url}}"],
          "path": ["admin", "users"]
        }
      }
    },
    {
      "name": "10. Logout (Clears HttpOnly Cookie)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/logout",
          "host": ["{{base_url}}"],
          "path": ["auth", "logout"]
        }
      }
    }
  ]
}
